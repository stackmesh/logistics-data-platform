# Local development only. Replace every password before any shared or deployed use.
# docker compose loads this file. Copy it to .env to override without editing the template.
# Values are KEY=VALUE. Quotes are optional and must match on both ends.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_postgres_password
POSTGRES_DB=deals_bigdata

SOURCE_DB_NAME=deals_bigdata
SOURCE_DB_USER=source_reader
SOURCE_DB_PASSWORD=local_source_reader_password

DWH_DB_NAME=logistics_dwh
DWH_DB_USER=dwh_etl
DWH_DB_PASSWORD=local_dwh_etl_password

# Hostname on the compose network. Use localhost only when connecting from the host.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port, bound to 127.0.0.1 only. Not 5432, so a PostgreSQL already running on the host does not clash.
POSTGRES_PUBLISH_PORT=15432

# Passed to synthetic.sql as psql variable n_prices. The generator's own default is 300000.
N_PRICES=300000

# Client connect timeout in seconds.
PGCONNECT_TIMEOUT=10

# Snapshot date for the ETL profile, the mart cutoff, and the ML split. Never the system date.
# The pipeline exits with code 2 if it differs from the ML split's as_of (2026-10-26).
AS_OF_DATE=2026-10-26
ETL_FETCH_SIZE=50000
LOG_LEVEL=INFO

# Pipeline runner (python -m scripts.run_pipeline). Waits cover the first start, when the generator is still running.
PIPELINE_DB_WAIT_TIMEOUT_S=600
PIPELINE_DB_WAIT_INTERVAL_S=5
PIPELINE_RETRY_BACKOFF_S=5

# Airflow (docker compose --profile airflow). The metadata database is a separate PostgreSQL server.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=local_airflow_password
# Shared by the API server and the scheduler to sign task tokens. Any long random string.
AIRFLOW__API_AUTH__JWT_SECRET=local_airflow_jwt_secret_replace_me
# Host port of the Airflow UI and API, bound to 127.0.0.1 only.
AIRFLOW_PUBLISH_PORT=18080
# Retries per DAG task for transient failures (connection loss, server restart), with exponential backoff.
PIPELINE_AIRFLOW_RETRIES=3
PIPELINE_AIRFLOW_RETRY_DELAY_S=60

# Read-only warehouse login for BI (docker/postgres/03_bi_reader.sh). The role name is fixed: bi_reader.
BI_DB_USER=bi_reader
BI_DB_PASSWORD=local_bi_reader_password

# Superset (docker compose --profile superset). The metadata database is a separate PostgreSQL server.
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=local_superset_password
# Signs sessions and encrypts the stored warehouse password. Any long random string; keep it stable.
SUPERSET_SECRET_KEY=local_superset_secret_key_replace_me_with_a_long_random_string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=local_superset_admin_password
SUPERSET_ADMIN_EMAIL=admin@example.com
# Host port of the Superset UI, bound to 127.0.0.1 only.
SUPERSET_PUBLISH_PORT=18088

# ClickHouse analytical copy (docker compose --profile clickhouse). PostgreSQL stays authoritative.
# Hostname and HTTP port on the compose network. From the host: 127.0.0.1 and CLICKHOUSE_PUBLISH_PORT.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=logistics
CLICKHOUSE_USER=logistics
CLICKHOUSE_PASSWORD=local_clickhouse_password
# Host port of the ClickHouse HTTP interface, bound to 127.0.0.1 only.
CLICKHOUSE_PUBLISH_PORT=18123
# Rows per INSERT block. Each block carries a deduplication token, so a retried block is not stored twice.
CLICKHOUSE_INSERT_BATCH_ROWS=50000
# Incremental prediction loads re-read this many seconds before the watermark (late commits, clock skew).
CLICKHOUSE_WATERMARK_OVERLAP_S=3600
