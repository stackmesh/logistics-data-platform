# Local development only. Replace every password before any shared or deployed use.
# docker compose loads this file. Copy it to .env to override without editing the template.
# Values are KEY=VALUE. Quotes are optional and must match on both ends.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_postgres_password
POSTGRES_DB=deals_bigdata

SOURCE_DB_NAME=deals_bigdata
SOURCE_DB_USER=source_reader
SOURCE_DB_PASSWORD=local_source_reader_password

DWH_DB_NAME=logistics_dwh
DWH_DB_USER=dwh_etl
DWH_DB_PASSWORD=local_dwh_etl_password

# Hostname on the compose network. Use localhost only when connecting from the host.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=5432

# Passed to synthetic.sql as psql variable n_prices. The generator's own default is 300000.
N_PRICES=300000

# Client connect timeout in seconds.
PGCONNECT_TIMEOUT=10

# ETL. AS_OF_DATE is the snapshot date used for batch metadata and the run profile.
AS_OF_DATE=2026-10-26
ETL_FETCH_SIZE=50000
LOG_LEVEL=INFO
